<?xml version="1.0" encoding="utf-8"?>
<!-- One of the 2×1 grid's tiles: the 1×1 tile's background and icon, without the text. The whole tile is the tap target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outfit_widget_background">

    <include
        layout="@layout/outfit_widget_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
