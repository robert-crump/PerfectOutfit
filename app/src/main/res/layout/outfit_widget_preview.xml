<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: the tall layout with sample content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outfit_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_temperature"
            android:textColor="@color/widget_on_surface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_basis"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_preview_place"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/outfit_widget_chip"
            android:importantForAccessibility="no"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:src="@drawable/ic_work"
            android:tint="@color/widget_on_chip" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:src="@drawable/ic_walk"
            android:tint="@color/widget_on_surface_variant" />
    </LinearLayout>
</LinearLayout>
