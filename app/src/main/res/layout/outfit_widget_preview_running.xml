<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: the tile with sample content, lit. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outfit_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:background="@drawable/outfit_widget_chip"
        android:importantForAccessibility="no"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:src="@drawable/ic_sprint"
        android:tint="@color/widget_on_chip" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_temperature"
        android:textColor="@color/widget_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_caption"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
