<?xml version="1.0" encoding="utf-8"?>
<!-- Short widget, temperature 40 %, each icon 30 % (lit: on a chip; unlit: faint, no chip): temperature over one "basis · place" line; bike commute; walking. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/outfit_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/widget_temperature_area"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_no_temperature"
            android:textColor="@color/widget_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_icon_area_0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_icon_lit_0"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@drawable/outfit_widget_chip"
            android:importantForAccessibility="no"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_work"
            android:tint="@color/widget_on_chip" />

        <ImageView
            android:id="@+id/widget_icon_unlit_0"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_work"
            android:tint="@color/widget_on_surface_variant"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_icon_area_1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_icon_lit_1"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@drawable/outfit_widget_chip"
            android:importantForAccessibility="no"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_walk"
            android:tint="@color/widget_on_chip" />

        <ImageView
            android:id="@+id/widget_icon_unlit_1"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:alpha="0.4"
            android:importantForAccessibility="no"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:src="@drawable/ic_walk"
            android:tint="@color/widget_on_surface_variant"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
