<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget, Android 8–11: the app's static palette (values-v31 uses dynamic colours).
         Both palettes are named so the widget can force one when the theme isn't System. -->
    <color name="widget_surface_light">#FFEDF1E6</color>
    <color name="widget_on_surface_light">#FF1A1C18</color>
    <color name="widget_on_surface_variant_light">#FF424940</color>
    <color name="widget_accent_light">#FF2E6B30</color>

    <color name="widget_surface_dark">#FF242722</color>
    <color name="widget_on_surface_dark">#FFE2E3DC</color>
    <color name="widget_on_surface_variant_dark">#FFC2C9BD</color>
    <color name="widget_accent_dark">#FF95D58F</color>

    <!-- What the layouts use: the palette of the device's mode. -->
    <color name="widget_surface">@color/widget_surface_light</color>
    <color name="widget_on_surface">@color/widget_on_surface_light</color>
    <color name="widget_on_surface_variant">@color/widget_on_surface_variant_light</color>
    <color name="widget_accent">@color/widget_accent_light</color>
</resources>
